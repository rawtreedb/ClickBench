#!/bin/bash
# Reads a query from stdin, runs it with rawtree-client.
# Stderr: the runtime in fractional seconds on the last line (from --time).
# The same as ../rawtree/query, without runtime projections: the aggregates RawTree builds inside
# big parts from the shape of the queries it has seen, which make the repeated tries much faster.
set -e

rawtree-client --time --format=Null --use_runtime_projections=0
