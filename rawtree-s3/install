#!/bin/bash
set -e

# RawTree has no public install script yet, so the binary is taken from one of:
#   RAWTREE_BINARY      path to an already built binary (e.g. build_release/programs/rawtree)
#   RAWTREE_BINARY_URL  URL to download it from
# This is the only step that differs from a plain distribution install; see README.md.
if [ ! -x /usr/bin/rawtree ]; then
    if [ -n "${RAWTREE_BINARY:-}" ]; then
        cp "$RAWTREE_BINARY" rawtree
    elif [ -n "${RAWTREE_BINARY_URL:-}" ]; then
        wget --continue --progress=dot:giga -O rawtree "$RAWTREE_BINARY_URL"
    else
        echo "install: set RAWTREE_BINARY to a rawtree binary, or RAWTREE_BINARY_URL to download one" >&2
        exit 1
    fi

    chmod +x rawtree
    sudo ./rawtree install --noninteractive
fi

# MergeTree on S3 with a local filesystem cache, used by create.sql through storage_policy = 's3'.
#
# S3_ENDPOINT is the bucket URL with a key prefix, e.g. https://<bucket>.s3.<region>.amazonaws.com/rawtree/.
# The bucket should be in the machine's region: remote reads are bound by round-trip latency.
# Credentials come from the instance's IAM role via the metadata service (use_environment_credentials),
# so the role needs s3:GetObject, s3:PutObject, s3:DeleteObject and s3:ListBucket on the bucket.
#
# The cache path must be under /var/lib/rawtree/caches/, see clickhouse-web/install.
# ./flush-caches empties it before every cold run.
: "${S3_ENDPOINT:?install: set S3_ENDPOINT to https://<bucket>.s3.<region>.amazonaws.com/<prefix>/}"
sudo mkdir -p /etc/rawtree-server/config.d /var/lib/rawtree/caches/s3
sudo chown rawtree:rawtree /var/lib/rawtree/caches/s3
sudo tee /etc/rawtree-server/config.d/s3.yaml >/dev/null <<EOF2
storage_configuration:
  disks:
    s3:
      type: s3
      endpoint: ${S3_ENDPOINT}
      use_environment_credentials: true
    s3_cache:
      type: cache
      disk: s3
      path: /var/lib/rawtree/caches/s3/
      max_size: 100Gi
  policies:
    s3:
      volumes:
        main:
          disk: s3_cache
EOF2
