#!/bin/bash
set -e

# RawTree has no public install script yet, so the binary is taken from one of:
#   RAWTREE_BINARY      path to an already built binary (e.g. build_release/programs/rawtree)
#   RAWTREE_BINARY_URL  URL to download it from
# This is the only step that differs from a plain distribution install; see README.md.
if [ ! -x /usr/bin/rawtree ]; then
    if [ -n "${RAWTREE_BINARY:-}" ]; then
        cp "$RAWTREE_BINARY" rawtree
    elif [ -n "${RAWTREE_BINARY_URL:-}" ]; then
        wget --continue --progress=dot:giga -O rawtree "$RAWTREE_BINARY_URL"
    else
        echo "install: set RAWTREE_BINARY to a rawtree binary, or RAWTREE_BINARY_URL to download one" >&2
        exit 1
    fi

    chmod +x rawtree
    sudo ./rawtree install --noninteractive
fi
