#!/bin/bash
set -e

rawtree-client < create.sql

# Symlink the parquet files into RawTree's user_files dir rather than moving them: mv of the 14 GB
# partitioned dataset would copy bytes the server reads once and then we delete. `chown -h` sets the
# symlink's owner without following it, which is enough — the parquet files are mode 644.
for f in hits_*.parquet; do
    sudo ln -sf "$PWD/$f" /var/lib/rawtree/user_files/"$f"
done
sudo chown -h rawtree:rawtree /var/lib/rawtree/user_files/hits_*.parquet

# No column list and no schema: every parquet column becomes a dynamic path of `__raw_data`,
# keeping its concrete type.
#
# The four date/time columns are reinterpreted explicitly because the dataset carries no date
# semantics to infer. In hits_*.parquet they are declared as plain integers:
#
#   EventDate        INT32  logical Int(bitWidth=16, isSigned=false)
#   EventTime        INT64  logical None
#   ClientEventTime  INT64  logical None
#   LocalEventTime   INT64  logical None
#
# i.e. parquet's DATE/TIMESTAMP logical annotations are absent (the files were converted from
# ClickHouse's native format, which stores Date as UInt16 days and DateTime as seconds, and the
# conversion kept the physical layout while dropping the logical type). Any type-inferring reader
# therefore sees integers here. The typed entries recover the meaning from their hand-written DDL
# (`EventDate Date`, `EventTime TIMESTAMP`), which implicitly casts on INSERT; with no schema we
# have to state it. This is required for correctness, not tuning: 7 of the 43 queries compare
# EventDate against date literals, and against a Dynamic(UInt16) those silently match no rows.
rawtree-client --query "
    INSERT INTO hits
    SELECT * REPLACE (
        toDate(EventDate)           AS EventDate,
        toDateTime(EventTime)       AS EventTime,
        toDateTime(ClientEventTime) AS ClientEventTime,
        toDateTime(LocalEventTime)  AS LocalEventTime)
    FROM file('hits_*.parquet')" --max-insert-threads "$(( $(nproc) / 4 ))"

sudo rm -f /var/lib/rawtree/user_files/hits_*.parquet
sync
